<IfModule LiteSpeed>
    RewriteEngine On
    RewriteRule .* - [E=verifycaptcha:off]
</IfModule>

# BEGIN SECURITY HARDENING
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)[.](?!well-known(?:/|$)) - [F,L,NC]
    RewriteRule ^(?:public/)?(?:storage|uploads?)/.*[.](?:php[0-9]?|phtml|phar)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:public/)?storage/(?:logs|framework|app/private)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:composer[.](?:json|lock|phar)|package(?:-lock)?[.]json|artisan|phpunit[.]xml|AGENTS[.]md|CLAUDE[.]md|error_log|cookies[.]txt|server_deploy[.]sh|copy[.]sh|optimize[.]sh)$ - [F,L,NC]
</IfModule>
<FilesMatch "(?i)(?:[.](?:env|ini|log|sql|bak|old|orig|save|swp)|~)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
# END SECURITY HARDENING

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    <FilesMatch "\.(eot|otf|ttf|woff|woff2|jpg|jpeg|png|gif|webp|svg|ico)$">
        Header always set Access-Control-Allow-Origin "*"
    </FilesMatch>

    RewriteEngine On

    # Force non-WWW except for API routes, /public/, /storage/, etc.
    RewriteCond %{REQUEST_URI} !^/api/ [NC]
    RewriteCond %{REQUEST_URI} !^/public/ [NC]
    RewriteCond %{REQUEST_URI} !^/storage/ [NC]
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # Laravel public folder handling
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ ^$1 [N]

    RewriteCond %{REQUEST_URI} (\.\w+$) [NC]
    RewriteRule ^(.*)$ public/$1 [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ public/index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # Unset duplicate/malformed reporting headers to resolve browser console warnings
    Header always unset Report-To
    Header always unset Reporting-Endpoints
    Header unset Report-To
    Header unset Reporting-Endpoints
</IfModule>

<FilesMatch "^\.env$">
    Require all denied
</FilesMatch>

# BEGIN cPanel-generated php ini directives
<IfModule php_module>
    php_flag display_errors Off
    php_value max_execution_time 300
    php_value max_input_time 80
    php_value max_input_vars 1000
    php_value memory_limit 1G
    php_value post_max_size 50M

    # FIX SESSION ERROR
    php_value session.gc_probability 1
    php_value session.gc_divisor 1000
    php_value session.gc_maxlifetime 1440
    php_value session.save_path "/var/cpanel/php/sessions/ea-php84"

    php_value upload_max_filesize 10M
    php_flag zlib.output_compression Off
</IfModule>

<IfModule lsapi_module>
    php_flag display_errors Off
    php_value max_execution_time 300
    php_value max_input_time 80
    php_value max_input_vars 1000
    php_value memory_limit 1G
    php_value post_max_size 50M

    # FIX SESSION ERROR
    php_value session.gc_probability 1
    php_value session.gc_divisor 1000
    php_value session.gc_maxlifetime 1440
    php_value session.save_path "/var/cpanel/php/sessions/ea-php84"

    php_value upload_max_filesize 10M
    php_flag zlib.output_compression Off
</IfModule>
# END cPanel-generated php ini directives

# PHP 8.4 Handler
<IfModule mime_module>
    AddHandler application/x-httpd-alt-php84 .php .php8 .phtml
    AddHandler application/x-httpd-alt-php84___lsphp .php .php8 .phtml
</IfModule>
